generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductCategory {
  women
  men
  kids
}

enum ProductPrint {
  adire
  plain
}

enum OrderStatus {
  pending
  paid
  failed
}

model Product {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  description String
  material    String
  price       Int             @default(0)
  category    ProductCategory
  type        String
  print       ProductPrint
  inventory   Int             @default(0)
  featured    Boolean         @default(false)
  swatch      String
  pattern     String          @default("cross")
  details     Json            @default("[]")
  shipping    Json            @default("[]")
  sizes       Json            @default("[]")
  colors      Json            @default("[]")
  views       Json            @default("[]")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Order {
  id                String      @id @default(uuid())
  customerEmail     String
  customerName      String
  customerPhone     String?
  deliveryAddress   String?
  deliveryCity      String?
  deliveryState     String?
  deliveryCountry   String?
  deliveryNotes     String?
  amount            Int
  currency          String      @default("NGN")
  chargedAmount     Int?
  status            OrderStatus @default(pending)
  paystackReference String?     @unique
  items             Json        @default("[]")
  createdAt         DateTime    @default(now())
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model StoreSettings {
  id                      String   @id @default("default")
  usdRate                 Float    @default(1600)
  ghsRate                 Float    @default(100)
  lagosDeliveryFee        Int      @default(0)
  nigeriaDeliveryFee      Int      @default(0)
  internationalDeliveryFee Int     @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
